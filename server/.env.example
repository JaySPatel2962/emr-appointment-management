# Copy this file to .env and fill in real values. Never commit .env.
# Only MONGO_URI is required; every other variable has the default shown.

NODE_ENV=development
PORT=5000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# MongoDB Atlas connection string (placeholder: use your own user, password and cluster host)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/emr_appointments?retryWrites=true&w=majority
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Frontend origin allowed by CORS (credentials enabled)
CLIENT_URL=http://localhost:5173

# IANA timezone in which all appointment dates and times are stored and compared
CLINIC_TIMEZONE=Asia/Kolkata

# Number of reverse proxies in front of the API (0 when clients connect directly)
TRUST_PROXY_HOPS=0
# Maximum JSON request body size
BODY_LIMIT=100kb
# Rate limits per client IP, per window (15 minutes by default)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Failed login attempts allowed per window
LOGIN_RATE_LIMIT_MAX=10
