# Copy this file to .env and fill in real values. Never commit .env.
# Required: MONGO_URI and the two JWT secrets. Every other variable has the default shown.

NODE_ENV=development
PORT=5000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# MongoDB Atlas connection string (placeholder: use your own user, password and cluster host)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/emr_appointments?retryWrites=true&w=majority
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Frontend origin allowed by CORS (credentials enabled)
CLIENT_URL=http://localhost:5173

# IANA timezone in which all appointment dates and times are stored and compared
CLINIC_TIMEZONE=Asia/Kolkata

# JWT signing secrets: long random strings, different from each other.
# `npm run secrets` fills in both without printing them.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Access token lifetime in seconds (15 minutes)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in days
REFRESH_TOKEN_TTL_DAYS=7
# SameSite for the refresh cookie: strict when frontend and API share a site, none when they don't
REFRESH_COOKIE_SAMESITE=strict
# bcrypt cost factor (at least 10 in production)
BCRYPT_ROUNDS=12

# Number of reverse proxies in front of the API (0 when clients connect directly)
TRUST_PROXY_HOPS=0
# Maximum JSON request body size
BODY_LIMIT=100kb
# Rate limits per client IP, per window (15 minutes by default)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Failed login attempts allowed per window
LOGIN_RATE_LIMIT_MAX=10

# Seed script (`npm run seed`): the first Super Admin and the departments.
# The password needs 8+ characters with at least one letter and one number.
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_DEPARTMENTS=General Medicine,Cardiology,Dermatology,Orthopedics,Pediatrics
