# Copy this file to .env.local to change the defaults below. Never commit .env files.
# VITE_ values are compiled into the JavaScript bundle, so they are public: never put a secret here.

# Base URL of the REST API, including /api/v1. A path such as /api/v1 also works when a
# reverse proxy serves the API from the app's own origin.
VITE_API_URL=http://localhost:5000/api/v1

# Origin of the Socket.IO server: the API's host and port, without /api/v1.
# Leave it empty to use the origin of VITE_API_URL.
VITE_SOCKET_URL=http://localhost:5000
